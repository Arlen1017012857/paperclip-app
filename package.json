    "@trpc/client": "^11.1.1",
    "@trpc/next": "^11.1.1",
    "@trpc/react-query": "^11.1.1",
    "@trpc/server": "^11.1.1",
    "bcryptjs": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.43.1",
    "lucide-react": "^0.510.0",
    "next": "^15.3.1",
    "next-auth": "5.0.0-beta.25",
    "postgres": "^3.4.5",
    "posthog-js": "^1.373.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.4"
