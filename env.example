# Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env or .env.local to version control.

# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string for Drizzle ORM
# Local (Docker): postgres://paperclip:paperclip@localhost:5432/paperclip
DATABASE_URL=postgres://user:pass@localhost:5432/paperclip

# ── Auth (NextAuth.js v5) ────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
AUTH_SECRET=change-me-to-a-random-string
# Set this in production to your Vercel deployment URL
AUTH_URL=http://localhost:3000

# ── Error Tracking (Sentry) ──────────────────────────────────────────────
# Create a project at https://sentry.io and paste the DSN here
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production

# ── Analytics (PostHog) ──────────────────────────────────────────────────
# Create a project at https://app.posthog.com and get these values
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Vercel (for CI/CD) ───────────────────────────────────────────────────
# Set these as GitHub Actions secrets — never in .env files
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ── Optional: External services ──────────────────────────────────────────
# RESEND_API_KEY=re_xxxxxx  # Transactional emails (future)
# STRIPE_SECRET_KEY=sk_test_xxxxxx  # Payments (future)
